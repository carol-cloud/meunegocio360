# MeuNegocio360 - variáveis do frontend (Vite)
#
# Copie para .env.local (não versionado):  cp .env.example .env.local
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript do navegador e é PÚBLICA.
# Nunca coloque segredos, tokens ou senhas aqui.

# URL base da API, sempre RELATIVA (mesma origem do frontend).
# Em desenvolvimento, o server.proxy do Vite repassa /api ao backend local (http://localhost:8080);
# em produção, o Netlify repassa /api ao backend no Render.
VITE_API_BASE_URL=/api/v1
